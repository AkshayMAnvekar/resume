{
  "name": "Akshay_Resume",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:resume": "node scripts/build-resume.js",
    "dev": "npm run build:resume && vite --port 3000 --host 0.0.0.0",
    "build": "npm run build:resume && vite build",
    "lint": "npm run build:resume && htmlhint site/*.html index.html && prettier --check .",
    "format": "npm run build:resume && prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "htmlhint": "^1.9.2",
    "prettier": "^3.9.8",
    "vite": "^8.3.0"
  }
}
